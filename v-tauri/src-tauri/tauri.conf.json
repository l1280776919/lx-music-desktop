{
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "../frontend",
    "distDir": "../frontend"
  },
  "package": {
    "productName": "LX Music (Tauri)",
    "version": "0.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "clipboard": {
        "readText": true,
        "writeText": true
      },
      "shell": {
        "open": true
      }
    },
    "windows": [
      {
        "title": "LX Music (Tauri)",
        "width": 1100,
        "height": 760,
        "url": "index.html?os=linux&dt=true"
      }
    ],
    "security": {
      "csp": null
    },
    "bundle": {
      "active": true,
      "identifier": "com.lxmusic.tauri",
      "icon": [
        "icons/icon.png"
      ]
    }
  }
}
