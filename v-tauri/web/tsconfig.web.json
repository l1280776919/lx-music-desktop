{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": "../../",
    "paths": {
      "@common/*": ["src/common/*"],
      "@renderer/*": ["src/renderer/*"],
      "@static/*": ["src/static/*"],
      "@root/*": ["src/*"]
    }
  },
  "include": [
    "../../src/**/*.ts",
    "../../src/**/*.tsx",
    "../../src/**/*.js",
    "../../src/**/*.vue",
    "../../src/**/*.json"
  ]
}
